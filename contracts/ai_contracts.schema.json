    "ShotPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "shot_plan"
        },
        "schema_version": {
          "const": "1.0"
        },
        "production_id": {
          "type": "string",
          "format": "uuid"
        },
        "fps_num": {
          "type": "integer",
          "minimum": 1
        },
        "fps_den": {
          "type": "integer",
          "minimum": 1
        },
        "shots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Shot"
          }
        },
        "narration_reference_hash": {
          "type": "string"
        },
        "source_revision_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "production_id",
        "fps_num",
        "fps_den",
