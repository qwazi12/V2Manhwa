            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "INCOMPLETE"
          ]
        }
      },
      "required": [
        "kind",
        "schema_version",
        "script_beat_id",
        "audio_asset_id",
        "voice_config_hash",
        "decoded_duration_ms",
        "leading_silence_ms",
        "trailing_silence_ms",
        "speech_present",
        "asr_confidence",
        "checks",
        "status"
