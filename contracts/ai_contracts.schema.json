{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fns.example.invalid/contracts/ai_contracts.schema.json",
  "title": "Flamingo Next Studio AI artifact union",
  "description": "Strict structured outputs; generated data is untrusted until externally validated and, where required, reviewed.",
  "oneOf": [
    {
      "$ref": "#/$defs/EpisodeIntelligence"
    },
    {
      "$ref": "#/$defs/EpisodeOutline"
    },
    {
      "$ref": "#/$defs/NarrationScript"
    },
    {
      "$ref": "#/$defs/NarrativeCritique"
    },
    {
      "$ref": "#/$defs/AudioBeatResult"
    },
    {
      "$ref": "#/$defs/ShotPlan"
    },
    {
      "$ref": "#/$defs/ResearchAssessment"
    },
    {
      "$ref": "#/$defs/PackagingProposal"
    },
    {
      "$ref": "#/$defs/MediaQAReport"
    }
  ],
  "$defs": {
    "EvidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "panel",
            "ocr_line",
            "canon_claim",
            "market_observation",
            "human_review",
            "other"
          ]
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_role": {
          "type": "string",
          "enum": [
            "supports",
            "context",
            "contradicts"
          ]
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "source_kind",
        "evidence_role",
        "verified"
      ]
    },
    "OCRObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panel_id": {
          "type": "string",
          "format": "uuid"
        },
        "line_id": {
          "type": "string",
          "format": "uuid"
        },
        "line_order": {
          "type": "integer",
          "minimum": 1
        },
        "raw_text": {
          "type": "string"
        },
        "classification": {
          "type": "string",
          "enum": [
            "dialogue",
            "caption",
            "narration",
            "sfx",
            "credit",
            "other"
          ]
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "speaker_candidate_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "speaker_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": "number"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          }
        }
      },
      "required": [
        "panel_id",
        "line_id",
        "line_order",
        "raw_text",
        "classification",
        "speaker_candidate_id",
        "confidence",
        "evidence"
      ]
    },
    "PanelObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panel_id": {
          "type": "string",
          "format": "uuid"
        },
        "page_id": {
          "type": "string",
          "format": "uuid"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "visual_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferences": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visible_character_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "panel_kind": {
          "type": "string",
          "enum": [
            "art",
            "bubble_only",
            "credit",
            "decoration",
            "unknown"
          ]
        },
        "ocr": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OCRObservation"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          }
        }
      },
      "required": [
        "panel_id",
        "page_id",
        "order",
        "visual_facts",
        "inferences",
        "visible_character_ids",
        "panel_kind",
        "ocr",
        "uncertainties",
        "evidence"
      ]
    },
    "StoryEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "scene_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "action": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "fact_class": {
          "type": "string",
          "enum": [
            "observed",
            "interpreted",
            "owner_approved"
          ]
        },
        "significance": {
          "type": "string",
          "enum": [
            "critical",
            "major",
            "minor",
            "background"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "event_id",
        "scene_id",
        "sequence",
        "actors",
        "action",
        "result",
        "fact_class",
        "significance",
        "evidence",
        "uncertainties"
      ]
    },
    "StoryScene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "purpose": {
          "type": "string"
        },
        "setting": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "panel_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "transition_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "spoil_in_earlier_scene": {
          "type": "boolean"
        }
      },
      "required": [
        "scene_id",
        "sequence",
        "purpose",
        "setting",
        "event_ids",
        "panel_ids",
        "transition_note",
        "spoil_in_earlier_scene"
      ]
    },
    "EpisodeIntelligence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "episode_intelligence"
        },
        "schema_version": {
          "const": "1.0"
        },
        "episode_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "canon_revision_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PanelObservation"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoryScene"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoryEvent"
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pages_expected": {
              "type": "integer"
            },
            "pages_seen": {
              "type": "integer"
            },
            "ocr_lines_seen": {
              "type": "integer"
            },
            "critical_events_reviewed": {
              "type": "integer"
            },
            "critical_events_total": {
              "type": "integer"
            }
          },
          "required": [
            "pages_expected",
            "pages_seen",
            "ocr_lines_seen",
            "critical_events_reviewed",
            "critical_events_total"
          ]
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "schema_version",
        "episode_id",
        "source_revision_id",
        "canon_revision_id",
        "panels",
        "scenes",
        "events",
        "coverage",
        "open_questions",
        "model_limitations"
      ]
    },
    "SceneOutline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scene_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "story_goal": {
          "type": "string"
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "must_retain_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "intended_length_words": {
          "type": "integer",
          "minimum": 0
        },
        "allow_compression": {
          "type": "boolean"
        },
        "emotional_intent": {
          "type": "string"
        },
        "transition_to_next": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scene_id",
        "sequence",
        "story_goal",
        "source_event_ids",
        "must_retain_event_ids",
        "intended_length_words",
        "allow_compression",
        "emotional_intent",
        "transition_to_next"
      ]
    },
    "EpisodeOutline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "episode_outline"
        },
        "schema_version": {
          "const": "1.0"
        },
        "episode_id": {
          "type": "string",
          "format": "uuid"
        },
        "logline": {
          "type": "string"
        },
        "narrative_arc": {
          "type": "string"
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SceneOutline"
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes_for_writer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "schema_version",
        "episode_id",
        "logline",
        "narrative_arc",
        "scenes",
        "unresolved_questions",
        "notes_for_writer"
      ]
    },
    "NarrationBeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beat_id": {
          "type": "string",
          "format": "uuid"
        },
        "scene_id": {
          "type": "string",
          "format": "uuid"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "spoken_text": {
          "type": "string"
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "source_line_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "story_purpose": {
          "type": "string"
        },
        "emotion": {
          "type": "string"
        },
        "pace": {
          "type": "string",
          "enum": [
            "slow",
            "moderate",
            "brisk",
            "urgent"
          ]
        },
        "pronunciation_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_intent": {
          "type": "string"
        }
      },
      "required": [
        "beat_id",
        "scene_id",
        "order",
        "spoken_text",
        "source_event_ids",
        "source_line_ids",
        "story_purpose",
        "emotion",
        "pace",
        "pronunciation_terms",
        "visual_intent"
      ]
    },
    "NarrationScript": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "narration_script"
        },
        "schema_version": {
          "const": "1.0"
        },
        "production_id": {
          "type": "string",
          "format": "uuid"
        },
        "canon_revision_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision_id": {
          "type": "string",
          "format": "uuid"
        },
        "beats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NarrationBeat"
          }
        },
        "remaining_uncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimated_word_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "schema_version",
        "production_id",
        "canon_revision_id",
        "source_revision_id",
        "beats",
        "remaining_uncertainties",
        "estimated_word_count"
      ]
    },
    "CritiqueFinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "type": "string",
          "format": "uuid"
        },
        "severity": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "claim_type": {
          "type": "string",
          "enum": [
            "omission",
            "fabrication",
            "wrong_speaker",
            "wrong_name",
            "order",
            "continuity",
            "repetition",
            "pacing",
            "other"
          ]
        },
        "beat_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "source_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceLink"
          }
        },
        "explanation": {
          "type": "string"
        },
        "proposed_fix": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        }
      },
      "required": [
        "finding_id",
        "severity",
        "claim_type",
        "beat_ids",
        "source_event_ids",
        "evidence",
        "explanation",
        "proposed_fix",
        "confidence"
      ]
    },
    "NarrativeCritique": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "narrative_critique"
        },
        "schema_version": {
          "const": "1.0"
        },
        "production_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "INCOMPLETE"
          ]
        },
        "evaluated_beat_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "evaluated_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CritiqueFinding"
          }
        },
        "omitted_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "schema_version",
        "production_id",
        "status",
        "evaluated_beat_ids",
        "evaluated_event_ids",
        "findings",
        "omitted_evidence_ids",
        "limitations"
      ]
    },
    "AudioBeatResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "audio_beat_result"
        },
        "schema_version": {
          "const": "1.0"
        },
        "script_beat_id": {
          "type": "string",
          "format": "uuid"
        },
        "audio_asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "voice_config_hash": {
          "type": "string"
