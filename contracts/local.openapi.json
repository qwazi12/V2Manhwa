  "components": {
    "schemas": {
      "BudgetResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "reserved_units": {
            "type": "integer",
            "title": "Reserved Units"
          },
          "settled_units": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Settled Units"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "job_id",
          "reserved_units",
          "settled_units"
        ],
        "title": "BudgetResponse"
      },
      "CancelRequest": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision"
        ],
        "title": "CancelRequest"
      },
      "EventResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "detail": {
            "additionalProperties": true,
            "type": "object",
            "title": "Detail"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "job_id",
          "kind",
          "detail",
          "created_at"
        ],
        "title": "EventResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IdentityResponse": {
        "properties": {
          "role": {
            "type": "string",
            "const": "owner",
            "title": "Role"
          },
          "csrf": {
            "type": "string",
            "title": "Csrf"
          },
          "mode": {
            "type": "string",
            "const": "local-synthetic",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "role",
          "csrf",
          "mode"
        ],
        "title": "IdentityResponse"
      },
      "JobRequest": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Title"
          },
          "source_kind": {
            "type": "string",
            "pattern": "^synthetic$",
            "title": "Source Kind",
            "default": "synthetic"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title"
        ],
        "title": "JobRequest"
      },
      "JobResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "state": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "REVIEW",
              "CANCELLED",
              "FAILED"
            ],
            "title": "State"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "attempt": {
            "type": "integer",
            "title": "Attempt"
          },
          "artifact_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artifact Sha"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventResponse"
            },
            "type": "array",
            "title": "Events"
          },
          "budget": {
            "$ref": "#/components/schemas/BudgetResponse"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "state",
          "revision",
          "attempt",
          "artifact_sha",
          "error",
          "created_at",
          "events",
          "budget"
        ],
        "title": "JobResponse"
      },
      "LoginRequest": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key"
        ],
        "title": "LoginRequest"
      },
      "PreviewResponse": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "expires_at": {
            "type": "integer",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "url",
          "sha256",
          "expires_at"
        ],
        "title": "PreviewResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
