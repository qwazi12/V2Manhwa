# Use python3 scripts/setup_local.py to generate fresh .env.local (mode 0600).
ENVIRONMENT=local
FNS_LOCAL_DEV_KEY=REPLACE_WITH_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
FNS_MEDIA_SIGNING_KEY=REPLACE_WITH_DIFFERENT_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
PUBLISHING_ENABLED=false
DRIVE_AUTO_COPY_ENABLED=false
AUTOPILOT_MODE=OFF
ALLOW_PROTECTED_SOURCE_SCRAPING=false
