# EXAMPLE ONLY — no actual credentials or existing project identifiers
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://fns_local:local_only@localhost:5432/fns_local
OBJECTSTORE_ENDPOINT=http://localhost:9000
OBJECTSTORE_BUCKET=fns-local-private
OBJECTSTORE_ACCESS_KEY=LOCAL_MINIO_ONLY
OBJECTSTORE_SECRET_KEY=REPLACE_WITH_LOCAL_ONLY_SECRET
SESSION_SIGNING_KEY=REPLACE_WITH_RANDOM_LOCAL_SECRET
CSRF_SIGNING_KEY=REPLACE_WITH_RANDOM_LOCAL_SECRET
PUBLISHING_ENABLED=false
DRIVE_AUTO_COPY_ENABLED=false
AUTOPILOT_MODE=OFF
ALLOW_PROTECTED_SOURCE_SCRAPING=false
ALLOWED_SOURCE_PROVIDERS=
MAX_EPISODE_AI_USD=10.0
MAX_DAY_AI_USD=35.0
MAX_MONTH_AI_USD=300.0
MAX_MEDIA_WORKERS=1
MAX_AI_WORKERS=2
MEDIA_SIGNED_URL_TTL_SECONDS=300
LOG_LEVEL=INFO
# All external provider keys absent unless new app owner separately authorizes them.
